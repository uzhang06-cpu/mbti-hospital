# DeepSeek API（对话生成）
OPENAI_API_KEY=sk-你的deepseek_key
OPENAI_BASE_URL=https://api.deepseek.com

# 阿里云 DashScope（Qwen 对话 + 语音识别 + TTS + 图片生成）
DASHSCOPE_API_KEY=sk-你的dashscope_key

# MongoDB Atlas 连接字符串（用于用户数据持久化）
MONGODB_URI=mongodb+srv://用户名:密码@cluster0.xxxx.mongodb.net/?appName=Cluster0

# JWT 签名密钥（随机长字符串）
JWT_SECRET=your_random_secret_here

# 服务端口（Render 会自动注入，本地可不填）
# PORT=5001
